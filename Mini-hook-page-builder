# ==============================================================================
# APP SPECIFICATION: MINI AFFILIATE HOOK PAGE BUILDER
# GOOGLE AI STUDIO / PYTHON FLASK / RENDER READY
# ==============================================================================

"""
PROMPT FOR GOOGLE AI STUDIO BUILD MODE:

Build a lightweight, mobile-responsive Flask web application that acts as a 
Mini Affiliate Hook Page Builder. The app has two main parts:
1. AN ADMIN DASHBOARD (Where I enter product details and get my shareable link)
2. A PUBLIC HOOK PAGE (Where visitors view the hook, enter email, and redirect to my affiliate link)

---

### ADMIN DASHBOARD FORM INPUTS:
- Field 1: Target Affiliate URL (Text box, required) - e.g., ClickBank, Amazon, Digistore24 link.
- Field 2: Product Name & Description (Text area, required) - Short summary of the offer.
- Field 3: Product Image URL (Text input, optional) - Link to a product cover/image.
- Field 4: Target Niche (Dropdown) - Options: "Make Money Online", "SaaS/Software", "E-Commerce", "Health/Fitness".

---

### BACKEND LOGIC (GEMINI API INTEGRATION):
1. When the user submits the form, pass Product Name, Description, and Niche to Gemini AI.
2. Instruct Gemini AI to output JSON containing:
   - "headline": Catchy, curiosity-driven headline for the niche.
   - "bullet_points": 3 high-converting benefit bullet points.
   - "cta_button_text": Strong action button text (e.g., "Get Instant Access Now").
3. Store the generated page in a SQLite database or JSON store mapped to a unique ID (e.g., /p/<page_id>).
4. Return a ready-to-copy URL for the generated page on the dashboard.

---

### PUBLIC HOOK PAGE DISPLAY & REDIRECT LOGIC:
Render the generated data inside a high-tech, responsive HTML template:

- Display Product Image (if provided), Headline, and 3 Bullet Points.
- Email Capture Box:
  - Input field for visitor's Email Address.
  - Submit Button with Gemini-generated CTA text.
- JavaScript Redirect Code on Form Submit:
  - When the visitor submits their email, save the email contact to the list.
  - Immediately execute: `window.location.href = "{{ affiliate_url }}";`
- Standard Legal Footer:
  - Include Affiliate Disclosure: "Disclosure: If you purchase through links on this page, I may receive an affiliate commission at no extra cost to you."

"""

# ==============================================================================
# PYTHON FLASK BACKEND CODE (main.py)
# ==============================================================================

import os
import json
import uuid
from flask import Flask, render_template, request, redirect, url_for, jsonify
import google.generativeai as genai

app = Flask(__name__)

# Configure Gemini API Key
genai.configure(api_key=os.environ.get("GEMINI_API_KEY", "YOUR_GEMINI_API_KEY"))

# In-Memory Storage for Hook Pages & Captured Emails (Use DB for production)
HOOK_PAGES = {}
CAPTURED_EMAILS = []

@app.route("/")
def dashboard():
    """Admin Dashboard to enter affiliate info and generate hook pages."""
    dashboard_html = """
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mini Hook Page Builder</title>
        <style>
            body { font-family: Arial, sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; }
            .container { max-width: 600px; margin: 0 auto; background: #1e293b; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
            h1 { text-align: center; color: #38bdf8; }
            label { font-weight: bold; margin-top: 15px; display: block; }
            input, select, textarea { width: 100%; padding: 10px; margin-top: 5px; border-radius: 5px; border: 1px solid #334155; background: #0f172a; color: #fff; box-sizing: border-box; }
            button { width: 100%; padding: 12px; margin-top: 20px; background: #0284c7; color: white; border: none; font-size: 16px; font-weight: bold; border-radius: 5px; cursor: pointer; }
            button:hover { background: #0369a1; }
            .result { margin-top: 20px; padding: 15px; background: #065f46; border-radius: 5px; word-break: break-all; }
        </style>
    </head>
    <body>
        <div class="container">
            <h1>Mini Hook Page Builder</h1>
            <form action="/generate" method="POST">
                <label>1. Target Affiliate URL:</label>
                <input type="url" name="affiliate_url" placeholder="https://your-affiliate-link.com" required>

                <label>2. Product Name & Short Summary:</label>
                <textarea name="product_summary" rows="3" placeholder="Describe the offer or product in a few sentences..." required></textarea>

                <label>3. Product Image URL (Optional):</label>
                <input type="url" name="image_url" placeholder="https://example.com/image.jpg">

                <label>4. Select Niche:</label>
                <select name="niche">
                    <option value="Make Money Online">Make Money Online</option>
                    <option value="SaaS/Software">SaaS / Software</option>
                    <option value="E-Commerce">E-Commerce</option>
                    <option value="Health/Fitness">Health / Fitness</option>
                </select>

                <button type="submit">Generate Hook Page</button>
            </form>
        </div>
    </body>
    </html>
    """
    return dashboard_html

@app.route("/generate", method=["POST"])
def generate():
    affiliate_url = request.form.get("affiliate_url")
    product_summary = request.form.get("product_summary")
    image_url = request.form.get("image_url")
    niche = request.form.get("niche")

    # Prompt Gemini to produce structured copy
    model = genai.GenerativeModel("gemini-1.5-flash")
    prompt = f"""
    You are an expert affiliate marketing copywriter. Write a high-converting hook page for the following offer:
    Niche: {niche}
    Product Summary: {product_summary}

    Return strictly a JSON object with these keys:
    - "headline": Curiosity-driven headline.
    - "bullet_1": First core benefit.
    - "bullet_2": Second core benefit.
    - "bullet_3": Third core benefit.
    - "cta": Strong CTA button text.
    """
    
    response = model.generate_content(prompt)
    
    try:
        clean_json = response.text.replace("```json", "").replace("```", "").strip()
        copy_data = json.loads(clean_json)
    except Exception:
        copy_data = {
            "headline": f"Discover The Secret To {niche}",
            "bullet_1": "Automated setup designed for fast results.",
            "bullet_2": "Step-by-step guidance included with full access.",
            "bullet_3": "Works seamlessly across modern online platforms.",
            "cta": "Get Instant Access Now"
        }

    page_id = str(uuid.uuid4())[:8]
    HOOK_PAGES[page_id] = {
        "affiliate_url": affiliate_url,
        "image_url": image_url,
        "copy": copy_data
    }

    page_link = request.host_url + "p/" + page_id
    
    return f"""
    <body style="background:#0f172a; color:#fff; font-family:Arial; padding:40px; text-align:center;">
        <div style="max-width:500px; margin:0 auto; background:#1e293b; padding:30px; border-radius:10px;">
            <h2 style="color:#38bdf8;">Hook Page Created Successfully!</h2>
            <p>Copy your share link and paste it to your social media posts:</p>
            <input type="text" value="{page_link}" style="width:100%; padding:10px; border-radius:5px;" readonly>
            <br><br>
            <a href="/" style="color:#38bdf8; text-decoration:none;">← Create Another Page</a>
        </div>
    </body>
    """

@app.route("/p/<page_id>")
def render_hook_page(page_id):
    page = HOOK_PAGES.get(page_id)
    if not page:
        return "Page Not Found", 404

    image_element = f'<img src="{page["image_url"]}" style="max-width:100%; border-radius:8px; margin-bottom:20px;">' if page.get("image_url") else ""

    hook_page_html = f"""
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{page['copy']['headline']}</title>
        <style>
            body {{ font-family: Arial, sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; display:flex; justify-content:center; align-items:center; min-height:90vh; margin:0; }}
            .card {{ max-width: 480px; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center; border: 1px solid #334155; }}
            h1 {{ color: #38bdf8; font-size: 22px; line-height: 1.4; }}
            ul {{ text-align: left; margin: 20px 0; padding-left: 20px; color: #cbd5e1; }}
            li {{ margin-bottom: 10px; font-size: 15px; }}
            input[type="email"] {{ width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: #fff; box-sizing: border-box; margin-bottom: 15px; font-size: 16px; }}
            button {{ width: 100%; padding: 14px; background: #22c55e; color: #000; border: none; font-size: 17px; font-weight: bold; border-radius: 6px; cursor: pointer; }}
            button:hover {{ background: #16a34a; }}
            .footer {{ font-size: 11px; color: #64748b; margin-top: 20px; }}
        </style>
    </head>
    <body>
        <div class="card">
            {image_element}
            <h1>{page['copy']['headline']}</h1>
            <ul>
                <li>✓ {page['copy']['bullet_1']}</li>
                <li>✓ {page['copy']['bullet_2']}</li>
                <li>✓ {page['copy']['bullet_3']}</li>
            </ul>
            <form onsubmit="handleCapture(event)">
                <input type="email" id="email" placeholder="Enter your best email address..." required>
                <button type="submit">{page['copy']['cta']}</button>
            </form>
            <div class="footer">
                Disclosure: If you purchase through links on this page, I may receive an affiliate commission at no extra cost to you.
            </div>
        </div>

        <script>
            function handleCapture(event) {{
                event.preventDefault();
                const email = document.getElementById('email').value;
                // Save lead and redirect immediately to affiliate link
                fetch('/capture', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ email: email, page_id: "{page_id}" }})
                }}).finally(() => {{
                    window.location.href = "{page['affiliate_url']}";
                }});
            }}
        </script>
    </body>
    </html>
    """
    return hook_page_html

@app.route("/capture", methods=["POST"])
def capture():
    data = request.get_json()
    if data and "email" in data:
        CAPTURED_EMAILS.append(data)
    return jsonify({"status": "success"})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
